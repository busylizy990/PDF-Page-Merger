# THIRD-PARTY-NOTICES.txt is generated by packaging\make_notices.py, which writes
# CRLF. Without this, git stores LF and reports the file modified after every
# build, which makes build.ps1's "notices CHANGED" warning fire constantly and so
# trains you to ignore the one message that matters for licence compliance.
THIRD-PARTY-NOTICES.txt text eol=crlf

# packaging\EULA.rtf is the same arrangement: generated by make_eula.py from
# LICENCE-TERMS.md, written CRLF, and regenerated by every build. Covered here
# explicitly rather than left to core.autocrlf, which is a per-machine setting
# and so not something a shared repository should depend on.
packaging/EULA.rtf text eol=crlf
